# ============================================
# Master Stock — Environment Variables
# ============================================
# Copy this file to .env and fill in your values.

# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/master_stock

# --- Ollama (Local LLM) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- Finnhub (News API) ---
# Get your free key at https://finnhub.io/register
FINNHUB_API_KEY=your_finnhub_api_key_here

# --- Alpha Vantage (Optional, for technical data) ---
# Get your free key at https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# --- Stocktwits (Social) ---
# No API key needed for public endpoints

# --- Sandbox Config ---
SANDBOX_INITIAL_CAPITAL=1000000
SANDBOX_TRANSACTION_FEE_PCT=0.001

# --- Server ---
API_HOST=0.0.0.0
API_PORT=8000
DASHBOARD_URL=http://localhost:3000
